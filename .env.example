# Public URL, generated by convex dev
NEXT_PUBLIC_CONVEX_URL=
# Local Convex CLI deployment selection. Never commit .env.local.
CONVEX_DEPLOYMENT=
# Convex Auth needs SITE_URL, JWT_PRIVATE_KEY and JWKS on its backend.
# Configure them with npx @convex-dev/auth (see README).
# No SMS or X credentials are needed.
